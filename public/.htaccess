<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # SEO: one canonical address, https://ilovemytools.store (SSL is active).
    # www -> non-www first, so http://www. needs only one redirect.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # http -> https
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # /index.php and /index.php/anything -> the clean URL (one address per page). THE_REQUEST is
    # the browser's own request line, so the internal rewrite to index.php below never loops.
    RewriteCond %{THE_REQUEST} \s/index\.php[/?\s] [NC]
    RewriteRule ^index\.php(?:/(.*))?$ https://%{HTTP_HOST}/$1 [L,R=301,NE]

    # Redirect Trailing Slashes If Not A Folder (one canonical URL per page)...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Correct type for the web app manifest (lets browsers offer "Install app").
AddType application/manifest+json .webmanifest
AddType text/xsl .xsl
AddType application/octet-stream .onnx

# Performance (Core Web Vitals): compress text and cache build assets for a year.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/wasm "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 week"
    ExpiresByType image/webp "access plus 1 week"
    ExpiresByType image/svg+xml "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 week"
</IfModule>

# Hashed build files (public/build/assets: JS, CSS, fonts, images and wasm with a content hash in
# the name) never change - a new build gets new names - so browsers and the firewall may keep them
# for a year. Other static files: one week. HTML is not matched here: Laravel sends its own short
# Cache-Control for pages (PageController::PAGE_CACHE).
<IfModule mod_headers.c>
    # The service worker must be re-checked on every visit, or updates would wait a year.
    <If "%{REQUEST_URI} == '/sw.js'">
        Header always set Cache-Control "no-cache"
        Header unset Expires
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/build/#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
        Header unset Expires
    </ElseIf>
    <ElseIf "%{REQUEST_URI} =~ m#\.(png|jpe?g|webp|svg|ico|webmanifest|woff2?|ttf)$#">
        Header always set Cache-Control "public, max-age=604800"
    </ElseIf>
    Header always unset X-Powered-By
</IfModule>
