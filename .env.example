# ---------------------------------------------------------------
# Site identity (change these to rebrand the whole site)
# ---------------------------------------------------------------
APP_NAME=Toolzy
SITE_TAGLINE="Free Online Tools - Fast, Private, No Sign Up"
CONTACT_EMAIL=hello@example.com
TWITTER_HANDLE=

# ---------------------------------------------------------------
# Laravel
# APP_ENV=production and APP_DEBUG=false on your live server!
# APP_URL must be your real domain with https (used for canonical URLs + sitemap)
# ---------------------------------------------------------------
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database is needed - all tools run in the browser.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# SEO
# ---------------------------------------------------------------
# Redirect-safe https URLs in production (keep true once SSL is on)
FORCE_HTTPS=true
# Paste only the content="..." value from Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# Proxies allowed to set X-Forwarded-For. Leave empty unless you are behind one.
# Cloudflare: list its IP ranges (cloudflare.com/ips) or your load balancer IP.
# "*" trusts every client, which lets anyone fake their IP - avoid it.
TRUSTED_PROXIES=

# ---------------------------------------------------------------
# Google AdSense (leave empty until your site is approved)
# ---------------------------------------------------------------
ADSENSE_CLIENT=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_BELOW_TOOL=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_IN_CONTENT=
ADSENSE_SLOT_FOOTER=
# Show grey "Ad space" boxes while designing (defaults to true only when APP_ENV=local)
ADS_SHOW_PLACEHOLDERS=
