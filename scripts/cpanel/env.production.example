# Production settings for https://ilovemytools.store
APP_NAME=ILoveTools
SITE_TAGLINE="Free Online Tools - Fast, Private, No Sign Up"
CONTACT_EMAIL=suggestions@ilovemytools.store
TWITTER_HANDLE=

APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ilovemytools.store

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# No database or sessions are used.
DB_CONNECTION=sqlite
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

FORCE_HTTPS=true
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GA4_MEASUREMENT_ID=G-GMWZ0PJW1R
# The domain sits behind the GoDaddy / Sucuri firewall; trust its ranges so
# request()->ip() is the visitor, not the firewall (sucuri.net/website-firewall IP list).
TRUSTED_PROXIES=192.88.134.0/23,185.93.228.0/22,66.248.200.0/22,208.109.0.0/22,2a02:fe80::/29
# Firewall API (GoDaddy Website Security > Firewall > API); deploy.sh uses it to clear the cache.
SUCURI_API_KEY=
SUCURI_API_SECRET=

ADSENSE_CLIENT=ca-pub-9006442709451377
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_BELOW_TOOL=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_IN_CONTENT=
ADSENSE_SLOT_FOOTER=
ADS_SHOW_PLACEHOLDERS=
